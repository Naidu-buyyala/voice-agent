# Application Settings
APP_NAME=Universal AI Action Agent
APP_ENV=development
DEBUG=True
PORT=8000

# Database (Phase 2)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/action_agent_db

# Gemini AI (Phase 4)
GEMINI_API_KEY=your-gemini-api-key-here

# Sarvam AI Voice Layer
SARVAM_API_KEY=your-sarvam-api-key-here

# Provider Configuration (Phase 8 & Phase 9)
DEFAULT_RIDE_PROVIDER=mock
UBER_CLIENT_ID=your-uber-client-id
UBER_CLIENT_SECRET=your-uber-client-secret
UBER_SANDBOX_MODE=True
